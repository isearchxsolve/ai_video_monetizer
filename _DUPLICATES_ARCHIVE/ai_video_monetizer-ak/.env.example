# AI VIDEO MONETIZER - AUTOMATION CONFIGURATION
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# GOOGLE WORKSPACE (Sheets, Drive, Docs)
# Get from: https://console.cloud.google.com/apis/credentials
# =============================================================================
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:1
GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/documents

# Token file location (auto-generated after first auth)
GOOGLE_TOKEN_PATH=~/.hermes/google_token.json

# Google Drive folder IDs (create folders first, then get IDs from URLs)
# Format: https://drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here
GOOGLE_DRIVE_SCRIPTS_FOLDER_ID=your_scripts_folder_id_here
GOOGLE_DRIVE_RAW_VIDEOS_FOLDER_ID=your_raw_videos_folder_id_here
GOOGLE_DRIVE_DIGITAL_PRODUCTS_FOLDER_ID=your_digital_products_folder_id_here

# Google Sheet ID (from URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEETS_CONTENT_PIPELINE_ID=your_sheet_id_here
GOOGLE_SHEETS_TAB_NAME=Sheet1

# =============================================================================
# AI VIDEO GENERATION APIs
# =============================================================================
# Runway Gen-3 API: https://runwayml.com/api/
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_API_URL=https://api.runwayml.com/v1

# Luma Dream Machine API: https://lumalabs.ai/dream-machine
LUMA_API_KEY=your_luma_api_key_here
LUMA_API_URL=https://api.lumalabs.ai/dream-machine/v1

# Kling API: https://klingai.com/api
KLING_API_KEY=your_kling_api_key_here
KLING_API_URL=https://api.klingai.com/v1

# Default video generation settings
DEFAULT_VIDEO_ASPECT_RATIO=9:16
DEFAULT_VIDEO_DURATION=5
DEFAULT_VIDEO_MOTION=low

# =============================================================================
# MAKE.COM (Integromat) - Automation Engine
# API Key: https://www.make.com/en/account/api
# =============================================================================
MAKE_API_KEY=your_make_api_key_here
MAKE_TEAM_ID=your_team_id_here
MAKE_SCENARIO_VIDEO_GENERATION_ID=your_scenario_id_here
MAKE_SCENARIO_SCHEDULING_ID=your_scenario_id_here
MAKE_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# MANYCHAT - Comment Automation & DM Funnel
# API: https://developers.manychat.com/
# =============================================================================
MANYCHAT_API_KEY=your_manychat_api_key_here
MANYCHAT_PAGE_ID=your_instagram_page_id_here
MANYCHAT_FLOW_ID=your_flow_id_here

# Trigger keywords (comma-separated)
MANYCHAT_TRIGGER_KEYWORDS=MAGNETIC,BLUEPRINT,SECRET,CODE

# =============================================================================
# GUMROAD - Digital Product Sales & Fulfillment
# API: https://app.gumroad.com/api
# =============================================================================
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here
GUMROAD_PRODUCT_BLUEPRINT_ID=your_blueprint_product_id_here
GUMROAD_PRODUCT_TEXTING_FRAMEWORK_ID=your_texting_framework_product_id_here
GUMROAD_WEBHOOK_SECRET=your_gumroad_webhook_secret_here

# Product pricing (USD)
GUMROAD_BLUEPRINT_PRICE=9.99
GUMROAD_TEXTING_FRAMEWORK_PRICE=10.00
GUMROAD_MASTERCLASS_PRICE=97.00

# =============================================================================
# SOCIAL MEDIA SCHEDULER (Choose one: Buffer, Metricool, or Later)
# =============================================================================
# Buffer: https://publish.buffer.com/developers/api
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
BUFFER_PROFILE_IDS=instagram_profile_id,tiktok_profile_id,youtube_profile_id

# Metricool: https://metricool.com/api/
METRICOOL_API_KEY=your_metricool_api_key_here
METRICOOL_BRAND_ID=your_brand_id_here

# Later: https://developers.later.com/
LATER_ACCESS_TOKEN=your_later_access_token_here
LATER_SOCIAL_PROFILE_IDS=instagram_profile_id,tiktok_profile_id

# Active scheduler (buffer, metricool, or later)
ACTIVE_SCHEDULER=buffer

# Posting schedule
POSTING_TIME_LOCAL=18:00
POSTING_TIMEZONE=America/New_York
POSTING_DAYS=mon,tue,wed,thu,fri,sat,sun

# =============================================================================
# CONTENT CONFIGURATION
# =============================================================================
CHANNEL_HANDLE=@auratension
CHANNEL_BIO=🪐 Exploring the unspoken laws of attraction & psychology.\n🎞️ Daily cinematic tension.\n🖤 Unlock your magnetic energy below 👇\n[YOUR_BEACONS_LINK]

# Video prompts file (relative to project root)
VIDEO_PROMPTS_FILE=config/video_prompts.json

# E-book files
EBOOK_MANUSCRIPT_FILE=content/ebook_manuscript.md
EBOOK_TEXTING_FRAMEWORK_FILE=content/texting_framework.md

# =============================================================================
# EMAIL MARKETING (Gumroad handles this, but optional for custom sequences)
# =============================================================================
# ConvertKit: https://developers.convertkit.com/
CONVERTKIT_API_KEY=your_convertkit_api_key_here
CONVERTKIT_FORM_ID=your_form_id_here
CONVERTKIT_SEQUENCE_ID=your_sequence_id_here

# =============================================================================
# ANALYTICS & TRACKING
# =============================================================================
# Google Analytics 4 Measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# TikTok Pixel ID
TIKTOK_PIXEL_ID=your_tiktok_pixel_id_here

# Meta Pixel ID (Facebook/Instagram)
META_PIXEL_ID=your_meta_pixel_id_here

# =============================================================================
# OPTIONAL: PROXY / RATE LIMITING
# =============================================================================
# Proxy for API requests (if needed)
HTTP_PROXY=
HTTPS_PROXY=

# Rate limiting (requests per minute)
RATE_LIMIT_RUNWAY=60
RATE_LIMIT_LUMA=30
RATE_LIMIT_KLING=30
RATE_LIMIT_GOOGLE_SHEETS=300
RATE_LIMIT_GOOGLE_DRIVE=300
RATE_LIMIT_MAKE=100
RATE_LIMIT_MANYCHAT=100
RATE_LIMIT_GUMROAD=100

# =============================================================================
# DEVELOPMENT / DEBUG
# =============================================================================
LOG_LEVEL=INFO
DEBUG_MODE=false
DRY_RUN=false
TEST_MODE=false